#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        win_bt: win_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "WIN_BT";
        };

        mac_bt: mac_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "MAC_BT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1            &kp N2        &kp N3            &kp N4             &kp N5  &mo 3                                                     &none              &kp N6  &kp N7    &kp N8  &kp N9    &kp N0     &kp BACKSLASH
&kp TAB    &kp SINGLE_QUOTE  &kp COMMA     &kp DOT           &kp P              &kp Y   &kp HOME                                                  &kp C_VOLUME_UP    &kp F   &kp G     &kp C   &kp R     &kp L      &kp SLASH
&kp ESC    &kp A             &kp O         &kp E             &kp U              &kp I   &kp END   &kp LCTRL  &kp LALT      &kp LGUI    &kp RCTRL  &kp C_VOLUME_DOWN  &kp D   &kp H     &kp T   &kp N     &kp S      &kp MINUS
&kp LSHFT  &kp SEMICOLON     &kp Q         &kp J             &kp K              &kp X                        &none         &none                                     &kp B   &kp M     &kp W   &kp V     &kp Z      &kp RSHFT
&kp LCTRL  &kp GRAVE         &kp LEFT_ALT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &kp BSPC  &mo 4      &kp DEL       &kp C_MUTE  &kp ENTER  &kp SPACE                  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT  &kp RCTRL
            >;
        };

        mac {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1            &kp N2        &kp N3            &kp N4             &kp N5  &mo 3                                                                &none              &kp N6  &kp N7    &kp N8  &kp N9    &kp N0     &kp BACKSLASH
&kp TAB    &kp SINGLE_QUOTE  &kp COMMA     &kp DOT           &kp P              &kp Y   &kp C_BRIGHTNESS_INC                                                 &kp C_VOLUME_UP    &kp F   &kp G     &kp C   &kp R     &kp L      &kp SLASH
&kp ESC    &kp A             &kp O         &kp E             &kp U              &kp I   &kp C_BRIGHTNESS_DEC  &kp LCMD  &kp LALT      &kp RCTRL   &kp RCMD   &kp C_VOLUME_DOWN  &kp D   &kp H     &kp T   &kp N     &kp S      &kp MINUS
&kp LSHFT  &kp SEMICOLON     &kp Q         &kp J             &kp K              &kp X                                   &none         &none                                     &kp B   &kp M     &kp W   &kp V     &kp Z      &kp RSHFT
&kp LCMD   &kp GRAVE         &kp LEFT_ALT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &kp BSPC              &mo 5     &kp DEL       &kp C_MUTE  &kp ENTER  &kp SPACE                  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT  &kp RCMD
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans     &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans     &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &trans
&tog 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                        &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &kp ENTER  &kp KP_N0          &kp LEFT    &kp RIGHT     &kp KP_DOT     &kp SPACE        &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &win_bt  &mac_bt  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                      &trans           &none  &none       &none       &none  &none  &none
&none           &none    &none    &none         &none         &none         &none                                                      &none            &none  &none       &none       &none  &none  &none
&studio_unlock  &none    &none    &none         &none         &none         &none            &bt BT_CLR  &none      &none  &bt BT_CLR  &none            &none  &none       &none       &none  &none  &none
&none           &none    &none    &none         &none         &none                                      &none      &none                               &none  &none       &none       &none  &none  &none
&bootloader     &none    &none    &bl BL_DEC    &bl BL_INC                  &rgb_ug RGB_TOG  &bl BL_TOG  &none      &none  &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &bootloader
            >;
        };

        win_fn {
            display-name = "win_fn";
            bindings = <
&kp F1        &kp F2  &kp F3  &kp F4   &kp F5    &kp F6  &trans                                      &trans  &kp F7  &kp F8    &kp F9       &kp F10        &kp F11  &kp F12
&trans        &trans  &trans  &trans   &trans    &trans  &trans                                      &trans  &trans  &trans    &trans       &trans         &trans   &trans
&trans        &trans  &trans  &trans   &trans    &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans       &trans         &trans   &trans
&kp CAPSLOCK  &trans  &trans  &trans   &trans    &trans                  &trans      &trans                  &trans  &trans    &trans       &trans         &trans   &trans
&trans        &trans  &trans  &kp TAB  &kp LALT          &trans  &trans  &trans      &trans  &tog 2  &trans          &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END  &trans
            >;
        };

        mac_fn {
            display-name = "mac_fn";
            bindings = <
&kp F1        &kp F2  &kp F3  &kp F4   &kp F5    &kp F6  &trans                                      &trans  &kp F7  &kp F8    &kp F9       &kp F10        &kp F11  &kp F12
&trans        &trans  &trans  &trans   &trans    &trans  &trans                                      &trans  &trans  &trans    &trans       &trans         &trans   &trans
&trans        &trans  &trans  &trans   &trans    &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans       &trans         &trans   &trans
&kp CAPSLOCK  &trans  &trans  &trans   &trans    &trans                  &trans      &trans                  &trans  &trans    &trans       &trans         &trans   &trans
&trans        &trans  &trans  &kp TAB  &kp LCMD          &trans  &trans  &trans      &trans  &tog 2  &trans          &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END  &trans
            >;
        };
    };
};
